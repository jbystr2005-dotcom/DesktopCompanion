<Window x:Class="DesktopCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Companion"
        Width="180"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Say hello" Click="SayHello_Click"/>
                <Separator/>
                <MenuItem Header="Exit companion" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Temporary character body -->
        <Ellipse Width="135"
                 Height="165"
                 VerticalAlignment="Bottom"
                 Fill="#FF7857C8"
                 Stroke="#FF3C267D"
                 StrokeThickness="5"/>

        <!-- Left ear -->
        <Ellipse Width="45"
                 Height="55"
                 Margin="15,18,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Fill="#FF7857C8"
                 Stroke="#FF3C267D"
                 StrokeThickness="5"/>

        <!-- Right ear -->
        <Ellipse Width="45"
                 Height="55"
                 Margin="0,18,15,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Fill="#FF7857C8"
                 Stroke="#FF3C267D"
                 StrokeThickness="5"/>

        <!-- Face -->
        <Ellipse Width="105"
                 Height="90"
                 Margin="0,58,0,0"
                 VerticalAlignment="Top"
                 Fill="#FFC7B5F3"/>

        <!-- Left eye -->
        <Ellipse Width="13"
                 Height="20"
                 Margin="50,82,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Fill="#FF18131F"/>

        <!-- Right eye -->
        <Ellipse Width="13"
                 Height="20"
                 Margin="0,82,50,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Fill="#FF18131F"/>

        <!-- Smile -->
        <Path Data="M 72,119 Q 90,134 108,119"
              Stroke="#FF18131F"
              StrokeThickness="4"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Fill="Transparent"/>

        <!-- Feet -->
        <Ellipse Width="55"
                 Height="24"
                 Margin="15,0,0,2"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Fill="#FF3C267D"/>

        <Ellipse Width="55"
                 Height="24"
                 Margin="0,0,15,2"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Fill="#FF3C267D"/>

        <!-- Speech bubble -->
        <Border x:Name="SpeechBubble"
                Padding="10,6"
                Margin="0,0,0,205"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="White"
                BorderBrush="#FF3C267D"
                BorderThickness="2"
                CornerRadius="10"
                Visibility="Collapsed">

            <TextBlock x:Name="SpeechText"
                       Text="Hello!"
                       Foreground="#FF18131F"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>